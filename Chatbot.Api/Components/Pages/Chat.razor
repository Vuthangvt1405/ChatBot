@page "/"
@inject IChatService ChatService
@inject IJSRuntime JS
@inject ILogger<Chat> Logger

<PageTitle>Chatbot</PageTitle>

<div class="chat">
    <header class="chat-header">Chatbot</header>

    <div class="chat-scroll" @ref="_scroll">
        @if (Restoring)
        {
            <div id="restore-indicator" class="typing restoring" role="status">Loading conversation<span class="dots"></span></div>
        }
        else if (_messages.Count == 0)
        {
            <div class="empty">How can I help you today?</div>
        }

        <ol id="messages" class="messages" aria-live="polite">
            @foreach (var message in _messages)
            {
                @* Razor encodes text, so replies are never rendered as HTML. *@
                <li class="message @message.Role">
                    <span class="label">@(message.Role == "user" ? "You" : "Assistant")</span>
                    <div class="text">@message.Text</div>
                </li>
            }
        </ol>

        @if (Sending)
        {
            <div id="typing-indicator" class="typing" role="status">Assistant is typing<span class="dots"></span></div>
        }
    </div>

    <div class="composer-wrap">
        <form id="chat-form" class="composer" @onsubmit="SendAsync">
            <RadzenTextArea id="chat-input" Rows="1" class="composer-input"
                            aria-label="Message" Placeholder="Message Chatbot"
                            @ref="_input" @bind-Value="_text" Immediate="true"
                            @onkeydown="OnKeyDownAsync" />
            <RadzenButton ButtonType="ButtonType.Submit" Icon="arrow_upward" class="send"
                          Shade="Shade.Darker" ButtonStyle="ButtonStyle.Base" aria-label="Send"
                          Disabled="@(!CanSend)" />
        </form>
        <div class="composer-footer">
            @if (TooLong)
            {
                <p id="chat-error" class="hint-error" role="alert">Message must be @ChatRequest.MaxMessageLength characters or fewer</p>
            }
            else
            {
                <p class="hint">Enter to send · Shift+Enter for a new line</p>
            }
            @if (Length > 0)
            {
                <span id="char-count" class="counter@(TooLong ? " over" : "")">@Length / @ChatRequest.MaxMessageLength</span>
            }
        </div>
    </div>
</div>

@code {
    private readonly List<ChatLine> _messages = [];
    private RadzenTextArea? _input;
    private string _text = "";
    private ElementReference _scroll;
    private Guid? _conversationId; // always the id from the latest reply (US-2 BR-1)
    private bool _scrollPending;

    /// <summary>US-4: true while a request is in flight. Drives the typing indicator and blocks a second send.</summary>
    private bool Sending { get; set; }

    /// <summary>US-5: true while the saved conversation's history is being loaded. Shows the restore indicator and blocks sending.</summary>
    private bool Restoring { get; set; }

    // US-3: length is measured on the trimmed text, which is what gets sent (BR-1).
    private int Length => _text.Trim().Length;
    private bool TooLong => Length > ChatRequest.MaxMessageLength;
    private bool CanSend => Length > 0 && !TooLong && !Sending && !Restoring;

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" && !e.ShiftKey ? SendAsync() : Task.CompletedTask;

    private async Task SendAsync()
    {
        if (!CanSend)
        {
            return;
        }

        // Set before the first await so a second submit is rejected server-side (AC5).
        Sending = true;
        var message = _text.Trim();

        AddMessage("user", message);
        StateHasChanged();

        try
        {
            var response = await ChatService.SendMessageAsync(
                new ChatRequest { ConversationId = _conversationId, Message = message },
                CancellationToken.None);

            _conversationId = response.ConversationId;
            AddMessage("assistant", response.Reply);

            // AC7: keep a draft typed while waiting.
            if (_text.Trim() == message)
            {
                _text = "";
            }

            // US-5 AC1: remember the conversation across reloads. Only the id is stored (BR-1).
            await JS.InvokeVoidAsync("chatStore.set", response.ConversationId.ToString());
        }
        catch (Exception ex)
        {
            // Never log the message text or show exception details (SEC3). Error UI is US-6.
            Logger.LogError(ex, "Chat send failed for conversation {ConversationId}", _conversationId);
        }
        finally
        {
            Sending = false;
        }

        if (_input is not null)
        {
            await _input.FocusAsync();
        }
    }

    private void AddMessage(string role, string text)
    {
        _messages.Add(new ChatLine(role, text));
        _scrollPending = true;
    }

    /// <summary>
    /// US-5: restores the saved conversation. Called once from OnAfterRenderAsync(firstRender),
    /// because localStorage (JS interop) isn't available while the page is prerendered.
    /// </summary>
    private async Task RestoreAsync()
    {
        Guid id;

        try
        {
            var saved = await JS.InvokeAsync<string?>("chatStore.get");

            if (saved is null)
            {
                return;
            }

            // AC7 / SEC2: a tampered value is dropped without touching the service.
            if (!Guid.TryParse(saved, out id))
            {
                await JS.InvokeVoidAsync("chatStore.clear");
                return;
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Could not read the saved conversation id.");
            return;
        }

        // AC5: show the indicator and block sending until the history is in.
        Restoring = true;
        StateHasChanged();

        try
        {
            var conversation = await ChatService.GetConversationAsync(id, CancellationToken.None);

            if (conversation is null)
            {
                // AC4: the conversation is gone; start fresh without an error.
                await JS.InvokeVoidAsync("chatStore.clear");
                return;
            }

            _conversationId = conversation.Id;

            foreach (var message in conversation.Messages)
            {
                AddMessage(message.Role, message.Content);
            }
        }
        catch (Exception ex)
        {
            // AC6 / D2: keep the saved id so a later reload can recover, and keep sending into it.
            // Log the id only, never content (SEC4).
            _conversationId = id;
            Logger.LogError(ex, "Restoring conversation {ConversationId} failed", id);
        }
        finally
        {
            Restoring = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // localStorage is only reachable once the circuit is live, not during prerender.
            // The re-render from RestoreAsync scrolls to the newest message.
            await RestoreAsync();
            return;
        }

        if (_scrollPending)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("chatScroll.toBottom", _scroll);
        }
    }

    private sealed record ChatLine(string Role, string Text);
}
